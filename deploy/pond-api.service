[Unit]
Description=Pond Catchment Analysis API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/pond-api
ExecStart=/opt/pond-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# Keep memory and CPU reasonable on the constrained box
MemoryLimit=400M

[Install]
WantedBy=multi-user.target
